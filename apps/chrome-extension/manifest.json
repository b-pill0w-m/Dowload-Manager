{
  "manifest_version": 3,
  "name": "Download Manager Detector",
  "version": "0.1.0",
  "description": "Detects normal downloadable requests and sends selected candidates to the desktop app.",
  "permissions": ["activeTab", "tabs", "storage", "webRequest"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:17891/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Download Manager"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
